# litellm-style "provider/model" string; switching providers (e.g. to
# "openai/gpt-5.2-mini" or "anthropic/claude-sonnet-5") only means
# changing these two lines, never any code.
LLM_MODEL=gemini/gemini-flash-latest
LLM_API_KEY=
# GITLEAKS_BINARY_PATH is left unset: an empty value would replace the
# "gitleaks" default with an empty string. Set it only if gitleaks isn't
# on PATH.
