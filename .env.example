# litellm-style "provider/model" string; switching providers (e.g. to
# "openai/gpt-5.2-mini" or "anthropic/claude-sonnet-5") only means
# changing these two lines, never any code.
LLM_MODEL=gemini/gemini-flash-latest
LLM_API_KEY=
# GITLEAKS_BINARY_PATH left unset on purpose: pydantic-settings treats a
# present-but-empty value as an override, which would clobber the field's
# "gitleaks" default (resolved via PATH) with an empty string. Only set
# this if gitleaks is NOT on PATH.
